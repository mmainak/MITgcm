# Diagnostics Package Choices
#--------------------------------------------------------------------
# List 1: Standard dynamics - every hour
#--------------------------------------------------------------------
 &DIAGNOSTICS_LIST
  frequency(1) = 3600.,
    fields(1:5,1) = 'UVEL    ','VVEL    ','WVEL    ',
                    'THETA   ','SALT    ',
    filename(1) = 'dynDiag',
#--------------------------------------------------------------------
# List 2: Passive tracer (sediment) - every hour
#--------------------------------------------------------------------
  frequency(2) = 3600.,
    fields(1:1,2) = 'TRAC01  ',
    filename(2) = 'ptrDiag',
#--------------------------------------------------------------------
# List 3: KPP diagnostics - every hour
#--------------------------------------------------------------------
  frequency(3) = 3600.,
    fields(1:2,3) = 'KPPhbl  ','KPPviscA',
    filename(3) = 'kppDiag',
 &

 &DIAG_STATIS_PARMS
 &
