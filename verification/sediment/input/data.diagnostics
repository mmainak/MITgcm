# ====================
# Diagnostics Package Configuration
# ====================
# Output frequency: 60s (every minute for detailed analysis)
#
 &DIAGNOSTICS_LIST
#--------------------------------------------------------------------
# List 1: Standard dynamics
#--------------------------------------------------------------------
  frequency(1) = 60.,
    fields(1:5,1) = 'UVEL    ','VVEL    ','WVEL    ',
                    'THETA   ','SALT    ',
    filename(1) = 'dynDiag',
#--------------------------------------------------------------------
# List 2: Passive tracer (sediment)
#--------------------------------------------------------------------
  frequency(2) = 60.,
    fields(1:1,2) = 'TRAC01  ',
    filename(2) = 'ptrDiag',
 &

 &DIAG_STATIS_PARMS
 &
